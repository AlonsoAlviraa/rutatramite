[Unit]
Description=RutaTramite private daily measurement
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=slot2
Group=slot2
WorkingDirectory=/srv/tenants/slot2/ops
ExecStart=/usr/bin/bash /srv/tenants/slot2/ops/daily_growth.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/tenants/slot2/metrics /srv/tenants/slot2/secrets/gsc

